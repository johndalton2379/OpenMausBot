{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmausbot:receipt:v1",
  "title": "Zero-model receipt event or acknowledgement v1",
  "$defs": {
    "eventId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f]+$"},
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "startupAuthorized", "revision", "evidence"],
      "properties": {"status": {"enum": ["ready", "blocked"]}, "startupAuthorized": {"const": false}, "revision": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/text"}}
    },
    "closeout": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "simulatedBankrollUsd", "skylitCreditCeiling", "skylitCreditsUsed", "evidence"],
      "properties": {"status": {"enum": ["closed", "incomplete"]}, "simulatedBankrollUsd": {"const": 10000}, "skylitCreditCeiling": {"const": 4000}, "skylitCreditsUsed": {"$ref": "#/$defs/ms"}, "evidence": {"$ref": "#/$defs/text"}}
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "eventId", "type", "producer", "createdAt", "expiresAt", "synthetic", "data"],
      "properties": {"schemaVersion": {"const": 1}, "eventId": {"$ref": "#/$defs/eventId"}, "type": {"const": "deployment-readiness"}, "producer": {"const": "runtime-keeper"}, "createdAt": {"$ref": "#/$defs/ms"}, "expiresAt": {"$ref": "#/$defs/ms"}, "synthetic": {"type": "boolean"}, "data": {"$ref": "#/$defs/readiness"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "eventId", "type", "producer", "createdAt", "expiresAt", "synthetic", "data"],
      "properties": {"schemaVersion": {"const": 1}, "eventId": {"$ref": "#/$defs/eventId"}, "type": {"const": "paper-session-closeout"}, "producer": {"const": "paper-operator"}, "createdAt": {"$ref": "#/$defs/ms"}, "expiresAt": {"$ref": "#/$defs/ms"}, "synthetic": {"type": "boolean"}, "data": {"$ref": "#/$defs/closeout"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "type", "eventId", "attempt"],
      "properties": {"schemaVersion": {"const": 1}, "type": {"const": "ack"}, "eventId": {"$ref": "#/$defs/eventId"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 10}}
    }
  ]
}
